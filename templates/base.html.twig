<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
            {# Bootstrap primero, tu CSS después, para que el tuyo pueda sobrescribirlo #}
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
            <link rel="stylesheet" href="{{ asset('css/app.css') }}">
            <link rel="preconnect" href="https://fonts.googleapis.com">
            <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
        {% endblock %}

        <html lang="es" data-bs-theme="dark">

        {% block javascripts %}
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        <nav class="navbar navbar-expand barra mb-4">
            <div class="container">
                <a class="navbar-brand" href="{{ path('app_tarea_index') }}">Tareas</a>
                <div class="navbar-nav ms-auto align-items-center">
                    {% if is_granted('ROLE_USER') %}
                        <span class="navbar-text me-3">Bienvenido, {{ app.user.email }}</span>
                        <a class="nav-link" href="{{ path('app_logout') }}">Cerrar sesión</a>
                    {% else %}
                        <a class="nav-link" href="{{ path('app_login') }}">Iniciar sesión</a>
                        <a class="nav-link" href="{{ path('app_register') }}">Registrarse</a>
                    {% endif %}
                </div>
            </div>
        </nav>

        <div class="container">
            {% for mensaje in app.flashes('success') %}
                <div class="alert alert-success">{{ mensaje }}</div>
            {% endfor %}

            {% block header %}
            {% endblock %}

            {% block body %}
            {% endblock %}

            <footer class="text-muted border-top mt-5 pt-3">Mi primer proyecto Symfony</footer>
        </div>
    </body>
</html>