{% extends "base.html.twig" %}

{% block title %}Lista de Tareas{% endblock %}

{% block body %}
    <h1>Tareas</h1>

    {% if is_granted('ROLE_USER') %}
        <a href="{{ path('app_tarea_nueva') }}">Nueva tarea</a>
    {% endif %}

    <ul>
        {% for tarea in tareas %}
            <li><a href="{{ path('app_tarea_ver', {'id': tarea.id}) }}">{{ tarea.titulo }}</a></li>
        {% else %}
            <li>No hay tareas disponibles.</li>
        {% endfor %}
    </ul>
{% endblock %}