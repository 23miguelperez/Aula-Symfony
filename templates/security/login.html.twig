{% extends 'base.html.twig' %}

{% block title %}Iniciar sesión{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h4 mb-4">Iniciar sesión</h1>

                    {% if error %}
                        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                    {% endif %}

                    {% if app.user %}
                        <div class="alert alert-info">
                            Ya has iniciado sesión como {{ app.user.userIdentifier }}.
                            <a href="{{ path('app_logout') }}">Cerrar sesión</a>
                        </div>
                    {% endif %}

                    <form method="post">
                        <div class="mb-3">
                            <label for="inputEmail" class="form-label">Email</label>
                            <input type="email" name="_username" id="inputEmail" class="form-control"
                                value="{{ last_username }}" autocomplete="email" required autofocus>
                        </div>

                        <div class="mb-3">
                            <label for="inputPassword" class="form-label">Contraseña</label>
                            <input type="password" name="_password" id="inputPassword" class="form-control"
                                autocomplete="current-password" required>
                        </div>

                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                        <button type="submit" class="btn btn-primary w-100 mt-2">Entrar</button>
                    </form>

                    <p class="text-center text-secondary small mt-4 mb-0">
                        ¿No tienes cuenta?
                        <a href="{{ path('app_register') }}">Regístrate</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}